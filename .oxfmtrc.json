{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"semi": false,
	"tabWidth": 2,
	"useTabs": true,
	"singleQuote": false,
	"sortImports": true,
	"sortTailwindcss": true,
	"sortPackageJson": true,
	"arrowParens": "always",
	"bracketSpacing": true,
	"insertFinalNewline": true,
	"objectWrap": "preserve",
	"printWidth": 80,
	"jsxWhitespaceSensitivity": "ignore",
	"proseWrap": "always",
	"quoteProps": "consistent",
	"singleAttributePerLine": true
}
