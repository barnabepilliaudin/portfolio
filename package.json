{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint:check": "oxlint",
    "lint:fix": "oxlint --fix",
    "preview": "vite preview",
    "format:check": "oxfmt --check",
    "format:fix": "oxfmt",
    "typecheck": "tsc -b",
    "check-code": "oxfmt --check && oxlint && pnpm run typecheck",
    "fix-code": "oxfmt && oxlint --fix && pnpm run typecheck"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
